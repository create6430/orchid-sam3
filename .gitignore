# 原始與中間資料不進 git（檔案太大，位置見 data/README.md）
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
.venv-train/
venv/
.ipynb_checkpoints/

# 作業系統與編輯器
.DS_Store
Thumbs.db
.vscode/
.idea/

# MATLAB
*.asv
*.mat.autosave

# Secrets
.env
.env.*
!.env.example

# Model weights
*.pt
*.pth
*.ckpt

# Logs and OS files
logs/
._*

# Derived COCO training inputs and local configuration smoke check
results/models/*/inputs/
results/models/config_check/
.pytest_cache/
pytest-cache-files-*/
